    "Pressure", "Stress", "Data", "The", "This", "Each", "Every", "Offshore", "Onshore", "Mature",
    "Producing", "Marginal", "Green", "Brown", "Name", "Free", "Full", "Total", "Whole", "Open", "Main"
  ],

  "well_prefixes": ["Dulang", "DL", "DUL"],

  "well_label_regex": "\\b(?:Well(?:\\s*Name)?|Wells|Telaga)\\s*[:#]\\s*([A-Z][A-Za-z0-9 ./-]{1,40})",

  "extra_well_regexes": [],

  "_well_exclude_comment": "Matched well names that also match one of these are dropped, e.g. 'Dulang 3D' (a survey, not a well).",
  "well_exclude_regexes": ["(?i)^\\S+ ?[234]D$"],

