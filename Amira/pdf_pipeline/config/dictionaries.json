    "Schlumberger", "SLB", "Western Geophysical", "WesternGeco", "CGG", "Veritas",
    "PGS", "Halliburton", "Baker Hughes", "Fugro", "Geco-Prakla", "Core Laboratories"
  ],

  "company_suffix_regex": "\\b(?:[A-Z][\\w&.'-]*\\s+){0,5}(?:Sdn\\.?\\s*Bhd\\.?|Berhad|Bhd\\.?|Inc\\.?|Ltd\\.?|Limited|Corporation|Corp\\.?|Company|Co\\.\\s*Ltd\\.?|LLC|plc|PLC|S\\.A\\.|B\\.V\\.|GmbH|AG)",

  "contractor_labels": [
    "Prepared by", "Submitted by", "Compiled by", "Processed by", "Acquired by",
    "Interpreted by", "Authored by", "Author", "Contractor", "Service Company", "Disediakan oleh"
  ],

  "operator_labels": [
    "Prepared for", "Submitted to", "Client", "Operator", "Customer", "For", "Disediakan untuk"
  ],

  "date_labels": ["Report Date", "Date of Report", "Date", "Issued", "Issue Date", "Tarikh"],

  "known_fields": ["Dulang"],

  "field_stopwords": [
