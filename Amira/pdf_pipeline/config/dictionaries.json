{
  "_comment": "Editable extraction rules. All matching is local and deterministic. Add your own companies, fields and well prefixes here.",

  "cover_pages": 3,
  "date_dayfirst": true,

  "title_keywords": [
    "REPORT", "SURVEY", "PROCESSING", "REPROCESSING", "INTERPRETATION", "ACQUISITION",
    "FINAL", "COMPLETION", "EVALUATION", "STUDY", "ANALYSIS", "PROGRAMME", "PROGRAM",
    "LAPORAN", "KAJIAN"
  ],

  "known_companies": [
